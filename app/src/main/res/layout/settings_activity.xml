<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="RtlSymmetry">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="返回"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_previous"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/btn_back"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Xmov 数字人配置 -->
        <TextView
            android:id="@+id/tv_xmov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数字人（Xmov）"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title" />

        <LinearLayout
            android:id="@+id/ll_app_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tv_xmov"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/app_id"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/app_id_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_view"
                android:hint="@string/app_edit_id_hint"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:textSize="14sp"
                tools:ignore="NestedWeights" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_app_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/ll_app_id"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/app_secret"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/app_secret_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_view"
                android:hint="@string/app_edit_secret_hint"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:textSize="14sp"
                tools:ignore="NestedWeights" />
        </LinearLayout>

        <!-- LLM 配置 -->
        <TextView
            android:id="@+id/tv_llm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="大模型（APIMart / DeepSeek）"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_app_secret" />

        <LinearLayout
            android:id="@+id/ll_llm_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tv_llm"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="API Key"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/llm_api_key_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_view"
                android:hint="填 APIMart 的 API Key"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:textSize="14sp"
                tools:ignore="NestedWeights" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_llm_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/ll_llm_api_key"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="BaseURL"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/llm_base_url_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_view"
                android:hint="https://api.apimart.ai/v1"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:textSize="14sp"
                tools:ignore="NestedWeights" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_llm_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/ll_llm_base_url"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Model"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/llm_model_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_view"
                android:hint="deepseek-chat（示例）"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:textSize="14sp"
                tools:ignore="NestedWeights" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_test_llm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="测试 LLM 连接"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_llm_model" />

        <Button
            android:id="@+id/start_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/click_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_llm_model" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
