<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".GameActivity">

    <!-- 数字人渲染层 -->
    <FrameLayout
        android:id="@+id/avatar_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/game_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 场景插画 -->
    <ImageView
        android:id="@+id/iv_scene_image"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_margin="16dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@android:drawable/ic_menu_gallery" />

    <!-- 对话日志切换按钮 -->
    <Button
        android:id="@+id/btn_toggle_log"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="📝 对话记录"
        android:textSize="12sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp" />

    <!-- 对话日志面板 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat_log"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="#DDFFFFFF"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btn_toggle_log"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp" />

    <!-- 场景标题 -->
    <TextView
        android:id="@+id/tv_scene_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="场景标题"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:shadowColor="@android:color/black"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:padding="8dp"
        android:background="#80000000"
        app:layout_constraintTop_toBottomOf="@id/rv_chat_log"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 场景描述 -->
    <TextView
        android:id="@+id/tv_scene_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="场景描述文本"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:shadowColor="@android:color/black"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:padding="12dp"
        android:background="#80000000"
        android:maxLines="4"
        android:ellipsize="end"
        app:layout_constraintBottom_toTopOf="@id/game_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp" />

    <!-- 游戏操作面板 -->
    <LinearLayout
        android:id="@+id/game_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 线索显示 -->
        <TextView
            android:id="@+id/tv_clues"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="已获线索: 0"
            android:textSize="12sp"
            android:textColor="@android:color/black"
            android:background="#F0F0F0"
            android:padding="8dp"
            android:gravity="start|top"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <!-- 动作按钮组 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_action_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="🔍 搜查"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_action_talk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="💬 对话"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_action_investigate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="🔬 调查"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_action_dice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="🎲 骰点"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />
        </LinearLayout>

        <!-- 功能按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_clues"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="📜 线索卡"
                android:layout_weight="1"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_players"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="👥 玩家"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_end_game"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="🏁 结束"
                android:layout_weight="1"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- 输入框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_player_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="输入对话或指令..."
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:layout_weight="1"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_voice_input"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="🎤"
                android:layout_marginEnd="4dp"
                style="@style/Widget.Material3.Button.IconButton" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发送"
                android:minWidth="60dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
